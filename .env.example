# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# ===== 必填 =====
# 千问AI平台（platform.qianwenai.com）→ API Keys → 创建
# 注意：这里的 Key 与阿里云百炼的 Key 不通用，必须配合下面的 API_HOST 使用
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 上游入口 =====
# 千问AI平台（千问云）        https://maas.qianwenaiapi.com     ← 默认
# 阿里云百炼（华北2 北京）    https://dashscope.aliyuncs.com
# 阿里云百炼（新加坡）        https://dashscope-intl.aliyuncs.com
# 换平台只改这一行，路径后缀 /compatible-mode/v1 两个平台一致
API_HOST=https://maas.qianwenaiapi.com

# ===== 通道选择 =====
# model = 直接调模型（不需要 APP_ID）
# agent = 调智能体应用（必须填 APP_ID，仅阿里云百炼支持）
LLM_MODE=model

# 百炼控制台 → 应用管理 → 应用卡片上复制
APP_ID=

# ===== 模型通道专用 =====
# 千问AI平台可用值举例：qwen3.8-max / qwen3.7-plus / qwen3.7-flash / qwen3.5-ocr
# 注意 qwen-plus、qwen-turbo 这类老名字在新平台上无效，会返回 404/400
MODEL_NAME=qwen3.7-plus
TEMPERATURE=0.9
# 思考模式。写诗是短输出任务，开启后首字要等 20 秒以上、token 多烧 40 倍，
# 实测质量无提升，默认关闭。需要推理能力的场景再改 1
ENABLE_THINKING=0

# ===== 运行时 =====
# 单次调用硬超时（秒）。智能体挂插件后耗时不可控，建议 60~120
TIMEOUT_S=60
CONNECT_TIMEOUT_S=5
MAX_RETRIES=2

# 同时进行中的生成任务上限，超出的请求排队（不是报错）。
# 这个数直接决定同一时刻最多打几次上游，按账户额度调。
CONCURRENCY_LIMIT=8

# 主题长度上限（字）。超过直接拒绝，不进 prompt
MAX_THEME_CHARS=50

# ===== 部署 =====
SERVER_NAME=127.0.0.1
SERVER_PORT=7860
# 启动后是否自动开浏览器。服务器部署时设为 0
OPEN_BROWSER=1
