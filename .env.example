# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# ===== 必填 =====
# 百炼控制台 → 密钥管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 通道选择 =====
# model = 直接调模型（不需要 APP_ID）
# agent = 调百炼智能体应用（必须填 APP_ID）
LLM_MODE=model

# 百炼控制台 → 应用管理 → 应用卡片上复制
APP_ID=

# ===== 模型通道专用 =====
MODEL_NAME=qwen-plus
TEMPERATURE=0.9

# ===== 运行时 =====
# 单次调用硬超时（秒）。智能体挂插件后耗时不可控，建议 60~120
TIMEOUT_S=60
CONNECT_TIMEOUT_S=5
MAX_RETRIES=2

# Gradio 事件并发上限。默认 1 会让全站串行，必须调大
CONCURRENCY_LIMIT=8
MAX_THEME_CHARS=50

# ===== 部署 =====
SERVER_NAME=127.0.0.1
SERVER_PORT=7860

# 非北京地域（如新加坡）时改这里
# API_HOST=https://dashscope-intl.aliyuncs.com
